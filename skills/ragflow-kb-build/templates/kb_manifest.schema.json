{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lynxpurr/ragflow-skills/schemas/kb_manifest-0.1.schema.json",
  "title": "RAGFlow KB handoff manifest",
  "type": "object",
  "required": [
    "version",
    "dataset",
    "documents"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ragflow_base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id"
        ],
        "additionalProperties": true,
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "chunk_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
